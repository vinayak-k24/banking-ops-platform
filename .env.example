# Single env file for the whole repo. Copy to .env (git-ignored) and fill in.
# Read by: Next.js (dev/build), backend/config.py (local runs), docker-compose (backend service).
# On Cloud Run, set these as service env vars / Secret Manager instead.

# ---- Frontend ----
# Backend URL that /api/* is proxied to (read when `npm run dev` / `npm run build` starts).
BACKEND_URL=http://localhost:8000

# ---- Backend ----
ENVIRONMENT=demo
# memory | firestore
STORE_BACKEND=memory
GCP_PROJECT=
GCP_LOCATION=us-central1
GCS_BUCKET=
CORS_ORIGINS=["http://localhost:3000"]

# ---- Gemini agents (Google ADK) ----
AGENTS_ENABLED=false
GEMINI_MODEL=gemini-2.0-flash
# Per-question cap on model calls (protects credits from agent loops).
AGENT_MAX_LLM_CALLS=8

# Option A - API key (AI Studio key, or a Google Cloud API key with Vertex AI express mode):
GOOGLE_API_KEY=
#   For a Google Cloud / Vertex AI express-mode key, also set:
# GOOGLE_GENAI_USE_VERTEXAI=true
#   Do NOT also set GOOGLE_CLOUD_PROJECT with a key: the SDK then ignores the key and uses gcloud credentials.

# Option B - Vertex AI with a service account / `gcloud auth application-default login` (no key):
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Before spending credits: backend\.venv\Scripts\python backend\scripts\check_gemini.py
